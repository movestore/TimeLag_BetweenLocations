{
  "version": "1.2",
  "settings": [
    {
      "id": "units",
      "name": "Units",
      "description": "Choose the unit in which the time lag between consecutive locations and the median time lag per track are calculated.",
      "defaultValue": "min",
      "type": "RADIOBUTTONS",
      "options": [
        { "value": "s", "displayText": "Seconds" },
        { "value": "min", "displayText": "Minutes" },
        { "value": "h", "displayText": "Hours" },
        { "value": "d", "displayText": "Days" },
        { "value": "weeks", "displayText": "Weeks" },
        { "value": "month", "displayText": "Month" },
        { "value": "years", "displayText": "Years" }
      ]
    }
  ],
  "dependencies": {
    "R": [
      { "name": "move2" },
      { "name": "ggplot2" },
      { "name": "units" }
    ]
  },
  "license": {
    "key": "MIT"
  },
  "language": "eng",
  "keywords": [
    "timelag",
    "time",
    "duration",
    "interval",
    "median",
    "histogram"
  ],
