    }
  ],
  "references": [
    {
      "type": "Requires",
      "note": "Kranstauber B, Safi K, Scharf AK (2024). move2: R package for processing movement data. Methods in Ecology and Evolution. doi:10.1111/2041-210X.14383",
      "url": "https://doi.org/10.1111/2041-210X.14383"
    }
  ]
